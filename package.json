{
  "name": "karaoke",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "exe": "cargo build --release --manifest-path native/Cargo.toml",
    "check:native": "cargo test --manifest-path native/Cargo.toml",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:native"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
